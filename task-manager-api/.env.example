# Copy to .env and fill in real values. Never commit the real .env file.

# Flask session/token signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Enables Flask debug mode (interactive debugger, auto-reload). Must be "false" in production.
FLASK_DEBUG=false

# How long an auth token stays valid, in seconds. Default: 8 hours.
TOKEN_EXPIRY_SECONDS=28800

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///tasks.db

# Outbound email (used by services/notification_service.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
